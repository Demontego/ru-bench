    "version": "0.2.0",
    "configurations": [
        {
            "name": "onnxruntime_infer (base)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/onnxruntime_infer.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "--onnx",
                "exports/moss_base_step.opt.onnx",
                "--audio",
                "Звонок.wav",
                "--max-new-tokens",
                "512",
                "--providers",
                "CUDAExecutionProvider",
                "CPUExecutionProvider"
            ]
        },
        {
            "name": "onnxruntime_infer (lora_ru_e2)",
            "type": "debugpy",
